# ============================================================
# configs/.env.example
# Environment Variable Template — WebNotifier
# Owner: Rishita Ramola (scheduler/analytics section)
#
# USAGE:
#   cp configs/.env.example configs/.env
#   nano configs/.env        # fill in real values
#   # NEVER commit configs/.env to git
#
# All sensitive values are consumed via std::getenv() in C++ code.
# NO credentials are hardcoded anywhere in the source.
# ============================================================

# ── PostgreSQL Database ───────────────────────────────────────
# Required by: scheduler_daemon, report_generator, analytics_engine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webnotifier
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSLMODE=prefer

# Worker Count
WORKER_COUNT=8

# ── Scheduler Daemon ──────────────────────────────────────────
# Max tasks the TaskQueue can hold before blocking (backpressure)
QUEUE_CAPACITY=1000

# Scheduling algorithm: "fixed" (default) or "adaptive"
SCHEDULER_STRATEGY=fixed

# ── Report Generator ──────────────────────────────────────────
# Directory where CSV and PDF reports are written (absolute path)
REPORTS_DIR=/var/webnotifier/reports/

# Full path to wkhtmltopdf binary (leave blank to auto-detect on PATH)
# If not set and not on PATH, PDF generation falls back to CSV only.
WKHTMLTOPDF_PATH=

# ── Internal Email API (Divyansh's service) ───────────────────
# The scheduler calls this endpoint to dispatch weekly report emails.
# Example: http://localhost:8080
INTERNAL_API_HOST=http://localhost:8080

# A shared secret key used as X-Internal-Key header.
# Must match the value configured in Divyansh's backend.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SECRET

# ── Backend API (optional — for health checks) ────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── Logging ───────────────────────────────────────────────────
# Log verbosity: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
